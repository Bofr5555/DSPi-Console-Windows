<?xml version="1.0" encoding="utf-8"?>
<settings:SettingsModule
    x:Class="DSPiConsole.Settings.Pages.GeneralVolumePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:DSPiConsole.Settings"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <!--
        Globals — device-wide settings that are NOT part of an individual
        preset's DSP state:
          • Master volume persistence mode (always available).
          • Power-on startup behaviour (requires preset support).
          • Output-config (physical IO) persistence mode (requires preset support).
        The startup + output-config cards are hidden behind a notice when the
        firmware doesn't expose presets. (Consolidates the former Volume,
        Presets › Startup, and Presets › Inclusion pages.)
    -->
    <StackPanel Spacing="4">

        <!-- Firmware 1.1.6: the board's own name, stored on the device. Hidden on
             firmware without REQ_GET_DEVICE_NAME. -->
        <controls:SettingsCard x:Name="DeviceNameCard"
                                Header="Device name"
                                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse x:Name="DeviceNameDot" Width="7" Height="7"
                         Fill="#FFFF9F0A" VerticalAlignment="Center"
                         Visibility="Collapsed" ToolTipService.ToolTip="Not saved yet"/>
                <TextBox x:Name="DeviceNameBox" Width="220"
                         MaxLength="31"
                         PlaceholderText="Add a name"
                         TextChanging="OnNameTextChanging"
                         TextChanged="OnDeviceNameTextChanged"/>
            </StackPanel>
        </controls:SettingsCard>

        <!-- Firmware 1.1.6: the output latency target, from the device's own
             option table. Hidden when the firmware STALLs REQ_OUTPUT_LATENCY. -->
        <controls:SettingsCard x:Name="LatencyCard"
                                Header="Latency"
                                Visibility="Collapsed">
            <ComboBox x:Name="LatencyCombo"
                      MinWidth="160"
                      SelectionChanged="OnLatencyChanged"/>
        </controls:SettingsCard>

        <controls:SettingsCard Header="Master volume mode"
                                Description="How the master volume value is persisted across preset changes.">
            <ComboBox x:Name="MasterVolumeModeCombo"
                      MinWidth="160"
                      SelectionChanged="OnMasterVolumeModeChanged">
                <ComboBoxItem Content="Independent" Tag="0"/>
                <ComboBoxItem Content="With Preset" Tag="1"/>
            </ComboBox>
        </controls:SettingsCard>

        <Border x:Name="UnsupportedNotice"
                Padding="12,8"
                Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="Collapsed">
            <TextBlock Text="Startup and output-configuration options require preset support, which this firmware version doesn't provide."
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"/>
        </Border>

        <controls:SettingsCard x:Name="StartupModeCard"
                                Header="Startup mode"
                                Description="Which preset loads when the device powers on.">
            <ComboBox x:Name="StartupModeCombo" MinWidth="160"
                      SelectionChanged="OnStartupModeChanged">
                <ComboBoxItem Content="Default preset" Tag="0"/>
                <ComboBoxItem Content="Last used"      Tag="1"/>
            </ComboBox>
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="DefaultPresetCard"
                                Header="Default startup preset"
                                Description="Used when Startup mode is &quot;Default preset&quot;.">
            <ComboBox x:Name="DefaultPresetCombo" MinWidth="200"
                      IsEnabled="False"
                      SelectionChanged="OnDefaultPresetChanged"/>
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="OutputConfigModeCard"
                                Header="Output configuration"
                                Description="How the physical IO config (output pins, output types, I2S MCK/BCK, S/PDIF RX pin) is persisted. Independent: IO is device-global and unchanged by preset loads; explicitly save with File &#x2192; Save Output Config. With Preset: each preset carries its own IO.">
            <ComboBox x:Name="OutputConfigModeCombo"
                      MinWidth="160"
                      SelectionChanged="OnOutputConfigModeChanged">
                <ComboBoxItem Content="Independent"  Tag="0"/>
                <ComboBoxItem Content="With Preset"  Tag="1"/>
            </ComboBox>
        </controls:SettingsCard>

        <!-- Firmware 1.1.6: a user name per input source, device-global. Rows
             are built in code, one per selectable source. -->
        <StackPanel x:Name="SourceNamesSection" Spacing="4" Visibility="Collapsed">
            <TextBlock Text="Source names" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="1,24,0,4"/>
            <StackPanel x:Name="SourceNameRows" Spacing="4"/>
            <TextBlock Text="Shown in the sidebar, on the front panel and on every connected computer. An empty name uses the built-in one."
                       FontSize="12" Margin="1,4,0,0" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
    </StackPanel>
</settings:SettingsModule>
